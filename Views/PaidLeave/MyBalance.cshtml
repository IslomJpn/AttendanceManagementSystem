@model AttendanceManagementSystem.ViewModels.PaidLeaveBalanceViewModel

@{
    ViewData["Title"] = "有給状況";

    bool isEligible =
        Model.LegalGrantedDays > 0 &&
        Model.IsAttendanceRateEnough;
}

@functions {
    string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("yyyy/MM/dd")
            : "-";
    }

    string FormatDateTime(DateTime? dateTime)
    {
        return dateTime.HasValue
            ? dateTime.Value.ToString("yyyy/MM/dd HH:mm")
            : "-";
    }

    string FormatDays(double days)
    {
        return days.ToString("0.#") + " 日";
    }
}

<div class="page-title-area">
    <h2>
        <i class="bi bi-calendar-check me-2"></i>
        有給状況
    </h2>
</div>

@if (!isEligible)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i>
        @Model.LegalMessage
    </div>
}
else if (Model.IsFiveDayAlertTarget)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @Model.LegalMessage
    </div>
}
else
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-1"></i>
        @Model.LegalMessage
    </div>
}

<div class="paidleave-summary-grid">
    <div class="summary-card">
        <div class="summary-label">
            <i class="bi bi-gift me-1"></i>
            付与日数
        </div>

        <div class="summary-value @(isEligible ? "text-primary" : "text-muted")">
            @FormatDays(Model.GrantedDays)
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-label">
            <i class="bi bi-check2-circle me-1"></i>
            使用日数
        </div>

        <div class="summary-value text-success">
            @FormatDays(Model.UsedDays)
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-label">
            <i class="bi bi-calendar-event me-1"></i>
            承認済み予定日数
        </div>

        <div class="summary-value text-warning">
            @FormatDays(Model.ReservedDays)
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-label">
            <i class="bi bi-calendar-minus me-1"></i>
            利用可能残日数
        </div>

        <div class="summary-value @(Model.RemainingDays > 0 ? "text-primary" : "text-danger")">
            @FormatDays(Model.RemainingDays)
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-label">
            <i class="bi bi-bell me-1"></i>
            年5日取得状況
        </div>

        @if (!isEligible)
        {
            <div class="summary-value text-muted">
                対象外
            </div>
        }
        else if (Model.RemainingFiveDayRequirement > 0)
        {
            <div class="summary-value text-warning">
                あと @FormatDays(Model.RemainingFiveDayRequirement)
            </div>
        }
        else
        {
            <div class="summary-value text-success">
                達成済み
            </div>
        }
    </div>
</div>

<div class="page-panel mt-4">
    <div class="page-panel-title">
        <i class="bi bi-arrow-left-right me-1"></i>
        有給残高の内訳
    </div>

    <div class="row g-3">
        <div class="col-md-4 col-xl">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="small text-muted mb-2">
                    当期付与日数
                </div>

                <div class="fw-bold fs-5 text-primary">
                    @FormatDays(Model.CurrentGrantedDays)
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="small text-muted mb-2">
                    繰越日数
                </div>

                <div class="fw-bold fs-5">
                    @FormatDays(Model.CarriedOverDays)
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="small text-muted mb-2">
                    失効日数
                </div>

                <div class="fw-bold fs-5
                    @(Model.ExpiredDays > 0
                         ? "text-danger"
                         : "text-muted")">

                    @FormatDays(Model.ExpiredDays)
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="small text-muted mb-2">
                    現在付与分の有効期限
                </div>

                <div class="fw-bold fs-5">
                    @FormatDate(Model.CurrentGrantExpiryDate)
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="small text-muted mb-2">
                    最終残高計算日時
                </div>

                <div class="fw-bold">
                    @FormatDateTime(Model.LastCalculatedAt)
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-panel mt-4">
    <div class="page-panel-title">
        <i class="bi bi-info-square me-1"></i>
        有給付与・取得義務の詳細
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="small text-muted">
                入社日
            </div>

            <div class="fw-bold">
                @Model.JoinDate.ToString("yyyy/MM/dd")
            </div>
        </div>

        <div class="col-md-3">
            <div class="small text-muted">
                現在の有給付与日
            </div>

            <div class="fw-bold">
                @FormatDate(Model.CurrentGrantDate)
            </div>
        </div>

        <div class="col-md-3">
            <div class="small text-muted">
                次回付与予定日
            </div>

            <div class="fw-bold">
                @Model.NextGrantDate.ToString("yyyy/MM/dd")
            </div>
        </div>

        <div class="col-md-3">
            <div class="small text-muted">
                年5日取得期限
            </div>

            <div class="fw-bold">
                @(isEligible
                    ? FormatDate(Model.FiveDayDeadline)
                    : "-")
            </div>
        </div>

        <div class="col-md-3">
            <div class="small text-muted">
                有給時効日
            </div>

            <div class="fw-bold">
                @(isEligible
                    ? FormatDate(Model.LegalExpiryDate)
                    : "-")
            </div>
        </div>

        <div class="col-md-3">
            <div class="small text-muted">
                法定付与日数
            </div>

            <div class="fw-bold">
                @(isEligible
                    ? Model.LegalGrantedDays + " 日"
                    : "0 日")
            </div>
        </div>

        <div class="col-md-3">
            <div class="small text-muted">
                出勤率確認期間
            </div>

            <div class="fw-bold">
                @Model.TotalWorkDaysInCheckPeriod 日中
                @Model.AttendedDaysInCheckPeriod 日
            </div>
        </div>

        <div class="col-md-3">
            <div class="small text-muted">
                出勤率
            </div>

            <div class="fw-bold @(Model.IsAttendanceRateEnough ? "text-success" : "text-danger")">
                @Model.AttendanceRate.ToString("0.#") %
            </div>
        </div>
    </div>
</div>


<div class="page-title-area mt-4">
    <h2>
        <i class="bi bi-clock-history me-2"></i>
        有給付与履歴
    </h2>
</div>

<div class="alert alert-light border">
    <i class="bi bi-info-circle me-1"></i>
    有給付与日の出勤率判定と付与内容を確認できます。
    履歴表の使用日数・残日数は、各付与履歴に保存された値です。
    最新の利用可能残日数は、下の現在残高をご確認ください。
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="border rounded-3 p-3 h-100 bg-white">
            <div class="small text-muted mb-2">
                現在の使用日数
            </div>

            <div class="fw-bold fs-5 text-success">
                @FormatDays(Model.UsedDays)
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="border rounded-3 p-3 h-100 bg-white">
            <div class="small text-muted mb-2">
                承認済み予定日数
            </div>

            <div class="fw-bold fs-5 text-warning">
                @FormatDays(Model.ReservedDays)
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="border rounded-3 p-3 h-100 bg-white">
            <div class="small text-muted mb-2">
                現在の利用可能残日数
            </div>

            <div class="fw-bold fs-5
                @(Model.RemainingDays > 0
                    ? "text-primary"
                    : "text-danger")">
                @FormatDays(Model.RemainingDays)
            </div>
        </div>
    </div>
</div>

<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>付与日</th>
                    <th style="min-width: 210px;">
                        出勤率確認期間
                    </th>
                    <th class="text-center">
                        所定労働日数
                    </th>
                    <th class="text-center">
                        出勤扱い日数
                    </th>
                    <th class="text-center">
                        出勤率
                    </th>
                    <th class="text-center">
                        80％条件
                    </th>
                    <th class="text-center">
                        付与結果
                    </th>
                    <th class="text-center">
                        付与日数
                    </th>
                    <th class="text-center">
                        履歴使用日数
                    </th>
                    <th class="text-center">
                        履歴残日数
                    </th>
                    <th>有効期限</th>
                    <th style="min-width: 280px;">
                        判定理由
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (Model.GrantHistories.Any())
                {
                    foreach (var history in Model.GrantHistories)
                    {
                        <tr>
                            <td class="text-nowrap fw-bold">
                                @history.GrantDate.ToString("yyyy/MM/dd")
                            </td>

                            <td class="text-nowrap">
                                @history.AttendanceCheckStartDate.ToString("yyyy/MM/dd")
                                ～
                                @history.AttendanceCheckEndDate.ToString("yyyy/MM/dd")
                            </td>

                            <td class="text-center">
                                @history.TotalWorkDays 日
                            </td>

                            <td class="text-center">
                                @history.AttendedDays 日
                            </td>

                            <td class="text-center fw-bold
                                @(history.IsAttendanceRateEnough
                                    ? "text-success"
                                    : "text-danger")">
                                @history.AttendanceRate.ToString("0.#") %
                            </td>

                            <td class="text-center">
                                @if (history.IsAttendanceRateEnough)
                                {
                                    <span class="badge bg-success">
                                        達成
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        未達
                                    </span>
                                }
                            </td>

                            <td class="text-center">
                                @if (history.GrantStatus == "付与")
                                {
                                    <span class="badge bg-primary">
                                        付与
                                    </span>
                                }
                                else if (history.GrantStatus == "不付与")
                                {
                                    <span class="badge bg-danger">
                                        不付与
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @history.GrantStatus
                                    </span>
                                }
                            </td>

                            <td class="text-center fw-bold">
                                @FormatDays(history.GrantedDays)
                            </td>

                            <td class="text-center">
                                @FormatDays(history.UsedDays)
                            </td>

                            <td class="text-center fw-bold
                                @(history.RemainingDays > 0
                                    ? "text-primary"
                                    : "text-muted")">
                                @FormatDays(history.RemainingDays)
                            </td>

                            <td class="text-nowrap">
                                @FormatDate(history.ExpiryDate)
                            </td>

                            <td style="min-width: 280px;">
                                @if (string.IsNullOrWhiteSpace(
                                    history.DecisionReason))
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }
                                else
                                {
                                    <div class="text-break">
                                        @history.DecisionReason
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12"
                            class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            有給付与履歴がありません。
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="small text-muted mt-2">
    <i class="bi bi-info-circle me-1"></i>
    履歴残日数は各付与履歴の保存値です。
    承認済み予定を差し引いた最新残高は、
    上の「現在の利用可能残日数」を確認してください。
</div>

<div class="page-title-area mt-4">
    <h2>
        <i class="bi bi-list-ul me-2"></i>
        有給申請履歴
    </h2>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i>
    有給申請の処理状況、処理者、管理者コメントを確認できます。
</div>

<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>申請ID</th>
                    <th>取得日</th>
                    <th>日数</th>
                    <th>申請理由</th>
                    <th>申請日時</th>
                    <th>状態</th>
                    <th>処理日時</th>
                    <th>処理者</th>
                    <th style="min-width: 240px;">
                        管理者コメント
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Requests.Any())
                {
                    foreach (var item in Model.Requests)
                    {
                        <tr>
                            <td>
                                @item.PaidLeaveRequestId
                            </td>

                            <td class="text-nowrap">
                                @item.LeaveDate.ToString("yyyy/MM/dd")
                            </td>

                            <td class="text-nowrap fw-bold">
                                @FormatDays(item.Days)
                            </td>

                            <td style="min-width: 180px;">
                                @if (string.IsNullOrWhiteSpace(item.Reason))
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }
                                else
                                {
                                    <div class="text-break">
                                        @item.Reason
                                    </div>
                                }
                            </td>

                            <td class="text-nowrap">
                                @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                            </td>

                            <td>
                                @if (item.Status == "申請中")
                                {
                                    <span class="badge bg-warning text-dark">
                                        申請中
                                    </span>
                                }
                                else if (item.Status == "承認")
                                {
                                    <span class="badge bg-success">
                                        承認
                                    </span>
                                }
                                else if (item.Status == "却下")
                                {
                                    <span class="badge bg-danger">
                                        却下
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                }
                            </td>

                            <td class="text-nowrap">
                                @if (item.ApprovedAt.HasValue)
                                {
                                    @FormatDateTime(item.ApprovedAt)
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(item.ApprovedByName) ||
                                     item.ApprovedByName == "-")
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }
                                else
                                {
                                    <div class="fw-bold">
                                        @item.ApprovedByName
                                    </div>

                                    @if (item.ApprovedBy.HasValue)
                                    {
                                        <div class="small text-muted">
                                            ID: @item.ApprovedBy
                                        </div>
                                    }
                                }
                            </td>

                            <td style="min-width: 240px;">
                                @if (string.IsNullOrWhiteSpace(item.AdminComment))
                                {
                                    <span class="text-muted">
                                        コメントなし
                                    </span>
                                }
                                else
                                {
                                    <div class="text-break">
                                        @item.AdminComment
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9"
                            class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            有給申請履歴がありません。
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="action-area">
    <a asp-controller="PaidLeave"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-calendar-plus me-1"></i>
        新しい有給申請
    </a>

    <a asp-controller="Attendance"
       asp-action="Index"
       class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        戻る
    </a>
</div>