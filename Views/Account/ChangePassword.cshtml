@using Microsoft.AspNetCore.Http
@model AttendanceManagementSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "パスワード変更";

    var role =
        Context.Session.GetString("LoginUserRole");

    var backController =
        role == "Admin"
            ? "Admin"
            : "Attendance";

    var successMessage =
        TempData["SuccessMessage"] as string;

    // 初回パスワード変更が完了した場合は、
    // 初回ログイン用メッセージを削除する
    if (!string.IsNullOrWhiteSpace(successMessage))
    {
        TempData.Remove("PasswordChangeMessage");
    }

    var initialPasswordMessage =
        TempData.Peek("PasswordChangeMessage")
            as string;

    var isInitialPasswordChange =
        !string.IsNullOrWhiteSpace(
            initialPasswordMessage
        );
}

<div class="page-title-area">
    <h2>
        <i class="bi bi-key-fill me-2"></i>

        @if (isInitialPasswordChange)
        {
            <text>初回パスワード設定</text>
        }
        else
        {
            <text>パスワード変更</text>
        }
    </h2>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill me-1"></i>
        @successMessage
    </div>
}

@if (isInitialPasswordChange)
{
    <div class="alert alert-danger">
        <div class="fw-bold mb-1">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            初回ログイン時のパスワード変更が必要です
        </div>

        <div>
            管理者が発行した初期パスワードを変更してください。
            パスワードを変更するまで、
            勤怠システムの他の機能は利用できません。
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-shield-lock-fill me-1"></i>
        セキュリティ保護のため、
        現在のパスワードと異なる
        8文字以上のパスワードを設定してください。
    </div>
}

<div class="page-panel">
    <div class="page-panel-title">
        <i class="bi bi-person-lock me-1"></i>

        @if (isInitialPasswordChange)
        {
            <text>初回パスワード情報</text>
        }
        else
        {
            <text>パスワード情報</text>
        }
    </div>

    <form asp-controller="Account"
          asp-action="ChangePassword"
          method="post"
          autocomplete="off">

        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="alert alert-danger">
            </div>
        }

        <div class="mb-3">
            <label asp-for="CurrentPassword"
                   class="form-label fw-bold">
            </label>

            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-lock-fill"></i>
                </span>

                <input asp-for="CurrentPassword"
                       class="form-control password-input"
                       autocomplete="current-password"
                       placeholder="現在のパスワードを入力してください" />
            </div>

            <span asp-validation-for="CurrentPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword"
                   class="form-label fw-bold">
            </label>

            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-key-fill"></i>
                </span>

                <input asp-for="NewPassword"
                       class="form-control password-input"
                       autocomplete="new-password"
                       placeholder="新しいパスワードを入力してください" />
            </div>

            <div class="form-text">
                8文字以上100文字以内で入力してください。
            </div>

            <span asp-validation-for="NewPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword"
                   class="form-label fw-bold">
            </label>

            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-check-circle-fill"></i>
                </span>

                <input asp-for="ConfirmPassword"
                       class="form-control password-input"
                       autocomplete="new-password"
                       placeholder="新しいパスワードをもう一度入力してください" />
            </div>

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="form-check mb-4">
            <input id="showPasswords"
                   type="checkbox"
                   class="form-check-input" />

            <label for="showPasswords"
                   class="form-check-label">
                パスワードを表示する
            </label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit"
                    class="btn btn-primary">

                @if (isInitialPasswordChange)
                {
                    <i class="bi bi-shield-check me-1"></i>
                    <text>初回パスワードを設定</text>
                }
                else
                {
                    <i class="bi bi-check-circle me-1"></i>
                    <text>パスワードを変更</text>
                }
            </button>

            @if (isInitialPasswordChange)
            {
                <a asp-controller="Account"
                   asp-action="Logout"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    ログアウト
                </a>
            }
            else
            {
                <a asp-controller="@backController"
                   asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    戻る
                </a>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const showPasswords =
                    document.getElementById(
                        "showPasswords"
                    );

                const passwordInputs =
                    document.querySelectorAll(
                        ".password-input"
                    );

                if (!showPasswords) {
                    return;
                }

                showPasswords.addEventListener(
                    "change",
                    function () {
                        const inputType =
                            this.checked
                                ? "text"
                                : "password";

                        passwordInputs.forEach(
                            function (input) {
                                input.type =
                                    inputType;
                            }
                        );
                    }
                );
            }
        );
    </script>
}