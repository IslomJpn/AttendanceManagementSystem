@{
    ViewData["Title"] = "ログイン";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-window-dots">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <div class="login-card-inner">
            <div class="login-icon">
                <i class="bi bi-people"></i>
            </div>

            <h2 class="login-title">勤怠管理システム</h2>
            <p class="login-subtitle">社員・管理者ログイン</p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label">メールアドレス</label>
                    <div class="input-icon-box">
                        <i class="bi bi-envelope"></i>
                        <input type="email" name="email" class="form-control" placeholder="example@company.co.jp" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">パスワード</label>
                    <div class="input-icon-box">
                        <i class="bi bi-lock"></i>
                        <input type="password" name="password" class="form-control" placeholder="パスワードを入力" />
                    </div>
                </div>

                <button type="submit" class="btn login-button w-100">
                    ログイン
                </button>
            </form>

            <div class="login-test-users">
                <div>※ 社員・管理者ともに同じログイン画面を使用します</div>
                <div>管理者: admin@example.com / password</div>
                <div>社員: employee@example.com / password</div>
            </div>
        </div>
    </div>
</div>