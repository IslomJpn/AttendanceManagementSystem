@model AttendanceManagementSystem.ViewModels.AdminPaidLeaveAlertViewModel

@{
    ViewData["Title"] = "有給アラート一覧";
}

@functions {
    string FormatDate(DateTime? date)
    {
        return date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    }

    string FormatDays(double days)
    {
        return days.ToString("0.#") + " 日";
    }
}

<div class="page-title-area">
    <h2><i class="bi bi-bell me-2"></i>有給アラート一覧</h2>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i>
    年5日取得義務が未達成の社員を表示しています。
</div>

<div class="table-wrapper">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>社員名</th>
                <th>部署</th>
                <th>入社日</th>
                <th>有給付与日</th>
                <th>取得期限</th>
                <th>付与日数</th>
                <th>使用日数</th>
                <th>残日数</th>
                <th>必要日数</th>
                <th>出勤率</th>
                <th>状態</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Alerts.Any())
            {
                foreach (var item in Model.Alerts)
                {
                    <tr>
                        <td>@item.EmployeeName</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.JoinDate.ToString("yyyy/MM/dd")</td>
                        <td>@FormatDate(item.CurrentGrantDate)</td>
                        <td>@FormatDate(item.FiveDayDeadline)</td>
                        <td>@item.GrantedDays 日</td>
                        <td>@FormatDays(item.UsedDays)</td>
                        <td>@FormatDays(item.RemainingDays)</td>
                        <td>
                            <span class="text-danger fw-bold">
                                あと @FormatDays(item.RemainingFiveDayRequirement)
                            </span>
                        </td>
                        <td>
                            @if (item.IsAttendanceRateEnough)
                            {
                                <span class="text-success fw-bold">@item.AttendanceRate.ToString("0.#") %</span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">@item.AttendanceRate.ToString("0.#") %</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-warning text-dark">@item.StatusText</span>
                        </td>
                        <td>
                            <a asp-controller="Admin"
                               asp-action="PaidLeaveNotice"
                               asp-route-employeeId="@item.EmployeeId"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-envelope-paper me-1"></i>通知文作成
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12" class="text-center text-muted py-4">
                        現在、有給アラート対象者はいません。
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="action-area">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>戻る
    </a>
</div>