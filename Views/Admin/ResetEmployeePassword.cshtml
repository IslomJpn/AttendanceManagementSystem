@model AttendanceManagementSystem.ViewModels.EmployeePasswordResetViewModel

@{
    ViewData["Title"] = "パスワード再発行";
}

<div class="page-title-area">
    <h2>
        <i class="bi bi-key-fill me-2"></i>
        パスワード再発行
    </h2>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle-fill me-1"></i>
    仮パスワードを再発行すると、現在のパスワードは使用できなくなります。
    社員は次回ログイン時に新しいパスワードへ変更する必要があります。
</div>

<div class="page-panel">
    <div class="page-panel-title">
        <i class="bi bi-person-lock me-1"></i>
        対象社員
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="text-secondary small">
                社員ID
            </div>

            <div class="fw-bold">
                @Model.EmployeeId
            </div>
        </div>

        <div class="col-md-4">
            <div class="text-secondary small">
                氏名
            </div>

            <div class="fw-bold">
                @Model.EmployeeName
            </div>
        </div>

        <div class="col-md-4">
            <div class="text-secondary small">
                メールアドレス
            </div>

            <div class="fw-bold text-break">
                @Model.Email
            </div>
        </div>
    </div>

    <form asp-controller="Admin"
          asp-action="ResetEmployeePassword"
          method="post"
          autocomplete="off">

        @Html.AntiForgeryToken()

        <input asp-for="EmployeeId"
               type="hidden" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="alert alert-danger">
            </div>
        }

        <div class="mb-3">
            <label asp-for="TemporaryPassword"
                   class="form-label fw-bold">
            </label>

            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-key"></i>
                </span>

                <input asp-for="TemporaryPassword"
                       class="form-control password-input"
                       autocomplete="new-password"
                       placeholder="8文字以上の仮パスワードを入力してください" />
            </div>

            <div class="form-text">
                現在のパスワードとは異なる、
                8文字以上100文字以内の仮パスワードを設定してください。
            </div>

            <span asp-validation-for="TemporaryPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmTemporaryPassword"
                   class="form-label fw-bold">
            </label>

            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-check2-circle"></i>
                </span>

                <input asp-for="ConfirmTemporaryPassword"
                       class="form-control password-input"
                       autocomplete="new-password"
                       placeholder="仮パスワードをもう一度入力してください" />
            </div>

            <span asp-validation-for="ConfirmTemporaryPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="form-check mb-4">
            <input id="showPasswords"
                   type="checkbox"
                   class="form-check-input" />

            <label for="showPasswords"
                   class="form-check-label">
                パスワードを表示する
            </label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit"
                    class="btn btn-danger"
                    onclick="return confirm('この社員の仮パスワードを再発行しますか？');">

                <i class="bi bi-arrow-repeat me-1"></i>
                仮パスワードを再発行
            </button>

            <a asp-controller="Admin"
               asp-action="Employees"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                戻る
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const showPasswords =
                    document.getElementById(
                        "showPasswords"
                    );

                const passwordInputs =
                    document.querySelectorAll(
                        ".password-input"
                    );

                if (!showPasswords) {
                    return;
                }

                showPasswords.addEventListener(
                    "change",
                    function () {
                        const inputType =
                            this.checked
                                ? "text"
                                : "password";

                        passwordInputs.forEach(
                            function (input) {
                                input.type =
                                    inputType;
                            }
                        );
                    }
                );
            }
        );
    </script>
}