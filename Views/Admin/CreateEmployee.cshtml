@model AttendanceManagementSystem.ViewModels.EmployeeCreateViewModel

@{
    ViewData["Title"] = "社員登録";
}

<div class="page-title-area">
    <h2>
        <i class="bi bi-person-plus-fill me-2"></i>
        社員登録
    </h2>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        入力内容を確認してください。
    </div>
}

<div class="alert alert-info">
    <i class="bi bi-info-circle-fill me-1"></i>
    初期値として勤務時間は09:00～18:00、
    所定労働時間は8時間、昼休憩は12:00～13:00に
    設定されています。必要に応じて変更してください。
</div>

<form asp-controller="Admin"
      asp-action="CreateEmployee"
      method="post"
      autocomplete="off">

    @Html.AntiForgeryToken()

    <div class="page-panel mb-4">
        <div class="page-panel-title">
            <i class="bi bi-person-vcard me-1"></i>
            基本情報
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Name"
                       class="form-label fw-bold">
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="氏名を入力してください"
                       autocomplete="name" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email"
                       class="form-label fw-bold">
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="メールアドレスを入力してください"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="Password"
                       class="form-label fw-bold">
                </label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-key-fill"></i>
                    </span>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="8文字以上で入力してください"
                           autocomplete="new-password" />
                </div>

                <div class="form-text">
                    社員は初回ログイン時に、
                    この初期パスワードを変更します。
                </div>

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="DepartmentId"
                       class="form-label fw-bold">
                </label>

                <select asp-for="DepartmentId"
                        class="form-select">

                    <option value="0">
                        選択してください
                    </option>

                    @foreach (var department in Model.Departments)
                    {
                        <option value="@department.DepartmentId">
                            @department.DepartmentName
                        </option>
                    }
                </select>

                <span asp-validation-for="DepartmentId"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="Role"
                       class="form-label fw-bold">
                </label>

                <select asp-for="Role"
                        class="form-select">
                    <option value="Employee">
                        社員
                    </option>

                    <option value="Admin">
                        管理者
                    </option>
                </select>

                <span asp-validation-for="Role"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="JoinDate"
                       class="form-label fw-bold">
                </label>

                <input asp-for="JoinDate"
                       type="text"
                       class="form-control js-date-picker"
                       value="@Model.JoinDate.ToString("yyyy-MM-dd")"
                       autocomplete="off" />

                <span asp-validation-for="JoinDate"
                      class="text-danger">
                </span>
            </div>
        </div>
    </div>

    <div class="page-panel mb-4">
        <div class="page-panel-title">
            <i class="bi bi-clock-fill me-1"></i>
            勤務時間設定
        </div>

        <div class="alert alert-light border">
            <i class="bi bi-calculator me-1"></i>
            遅刻時間、実働時間、休憩時間、残業時間は、
            ここで設定した勤務条件を基準に計算されます。
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="ScheduledStartTime"
                       class="form-label fw-bold">
                </label>

                <input asp-for="ScheduledStartTime"
                       type="time"
                       step="60"
                       class="form-control" />

                <span asp-validation-for="ScheduledStartTime"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="ScheduledEndTime"
                       class="form-label fw-bold">
                </label>

                <input asp-for="ScheduledEndTime"
                       type="time"
                       step="60"
                       class="form-control" />

                <span asp-validation-for="ScheduledEndTime"
                      class="text-danger">
                </span>
            </div>

            <div class="col-12">
                <label class="form-label fw-bold">
                    所定労働時間
                </label>

                <div class="row g-2">
                    <div class="col-md-3">
                        <div class="input-group">
                            <input asp-for="ScheduledWorkHours"
                                   type="number"
                                   min="0"
                                   max="23"
                                   class="form-control" />

                            <span class="input-group-text">
                                時間
                            </span>
                        </div>

                        <span asp-validation-for="ScheduledWorkHours"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-3">
                        <div class="input-group">
                            <input asp-for="ScheduledWorkMinutePart"
                                   type="number"
                                   min="0"
                                   max="59"
                                   class="form-control" />

                            <span class="input-group-text">
                                分
                            </span>
                        </div>

                        <span asp-validation-for="ScheduledWorkMinutePart"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="form-text">
                    残業時間は、実働時間がこの所定労働時間を
                    超えた場合に計算されます。
                </div>
            </div>
        </div>
    </div>

    <div class="page-panel mb-4">
        <div class="page-panel-title">
            <i class="bi bi-cup-hot-fill me-1"></i>
            休憩時間設定
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="LunchBreakStartTime"
                       class="form-label fw-bold">
                </label>

                <input asp-for="LunchBreakStartTime"
                       type="time"
                       step="60"
                       class="form-control" />

                <span asp-validation-for="LunchBreakStartTime"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="LunchBreakEndTime"
                       class="form-label fw-bold">
                </label>

                <input asp-for="LunchBreakEndTime"
                       type="time"
                       step="60"
                       class="form-control" />

                <span asp-validation-for="LunchBreakEndTime"
                      class="text-danger">
                </span>
            </div>
        </div>

        <hr class="my-4" />

        <div class="mb-3">
            <div class="fw-bold">
                <i class="bi bi-clock-history me-1"></i>
                小休憩1
            </div>

            <div class="form-text">
                小休憩がない場合は、開始時刻と終了時刻を
                両方空欄にしてください。
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="SmallBreak1StartTime"
                       class="form-label">
                </label>

                <input asp-for="SmallBreak1StartTime"
                       type="time"
                       step="60"
                       class="form-control" />

                <span asp-validation-for="SmallBreak1StartTime"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="SmallBreak1EndTime"
                       class="form-label">
                </label>

                <input asp-for="SmallBreak1EndTime"
                       type="time"
                       step="60"
                       class="form-control" />

                <span asp-validation-for="SmallBreak1EndTime"
                      class="text-danger">
                </span>
            </div>
        </div>

        <hr class="my-4" />

        <div class="mb-3">
            <div class="fw-bold">
                <i class="bi bi-clock-history me-1"></i>
                小休憩2
            </div>

            <div class="form-text">
                2回目の小休憩がない場合は、
                開始時刻と終了時刻を両方空欄にしてください。
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="SmallBreak2StartTime"
                       class="form-label">
                </label>

                <input asp-for="SmallBreak2StartTime"
                       type="time"
                       step="60"
                       class="form-control" />

                <span asp-validation-for="SmallBreak2StartTime"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6">
                <label asp-for="SmallBreak2EndTime"
                       class="form-label">
                </label>

                <input asp-for="SmallBreak2EndTime"
                       type="time"
                       step="60"
                       class="form-control" />

                <span asp-validation-for="SmallBreak2EndTime"
                      class="text-danger">
                </span>
            </div>
        </div>
    </div>

    <div class="action-area">
        <button type="submit"
                class="btn btn-primary">
            <i class="bi bi-check-circle-fill me-1"></i>
            登録する
        </button>

        <a asp-controller="Admin"
           asp-action="Employees"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            戻る
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}